#!/bin/sh

# Restart sxhkd on bspwm reload
pgrep -x sxhkd > /dev/null || sxhkd &

# start pipewire (auto-spawns wireplumber + pipewire-pulse via /etc/pipewire/pipewire.conf.d/)
pgrep -x pipewire >/dev/null || pipewire &

# Monitors + desktops: split 1-5 on internal, 6-10 on external when attached.
# Hotplug re-invokes the same script via the udev rule in
# /etc/udev/rules.d/95-monitor-hotplug.rules.
# https://wiki.archlinux.org/title/Bspwm#Multiple_monitors
"$HOME/.config/bspwm/screenlayout.sh"

# Layout
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Gaps (matching i3: inner 5, outer 1)
bspc config window_gap           5
bspc config top_padding          5
bspc config left_padding         1
bspc config right_padding        1
bspc config bottom_padding       1

# Borders
bspc config border_width         4

# Gruvbox colors
bspc config focused_border_color   "#d79921"  # yellow
bspc config normal_border_color    "#1d2021"  # darkgray
bspc config active_border_color    "#282828"  # bg
bspc config presel_feedback_color  "#458588"  # blue

# Autostart
setxkbmap -option "ctrl:nocaps" &
feh --bg-scale "/home/cian/Pictures/wallpapers/gruuvy-desert-3840x2160.png" &
xss-lock --transfer-sleep-lock -- i3lock --nofork &
dex --autostart --environment bspwm &

# picom 
picom --config ~/.config/picom/picom.conf --daemon &

# Bar is launched from screenlayout.sh so it spawns a bar per connected monitor
# and is re-run together with the layout on hotplug.
# https://github.com/polybar/polybar/wiki/Configuration#running-polybar-on-multiple-monitors
