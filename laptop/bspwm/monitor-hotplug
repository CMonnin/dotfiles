#!/bin/sh
# Run as root by monitor-hotplug.service on DRM hotplug events, then
# re-executes screenlayout.sh as the X session user.
# Installed root-owned to /usr/local/bin by install-hotplug.sh — never point
# udev or systemd at a copy the user can write, or it becomes a root shell.
# A start request for an already-running oneshot unit is coalesced by systemd,
# so bursts of events don't need debouncing here.
# Refs:
#   https://wiki.archlinux.org/title/Xrandr#Automatic_display_configuration_with_udev
#   https://wiki.archlinux.org/title/Udev

export DISPLAY=:0
export XAUTHORITY=/home/cian/.Xauthority

# Let the kernel/Xserver settle so xrandr sees the new state
sleep 0.5
exec runuser -u cian -- /home/cian/.config/bspwm/screenlayout.sh
