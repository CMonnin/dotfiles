# Re-run the bspwm screen layout whenever a DRM output is plugged in or out.
# udev kills long-running RUN+= jobs and their children, so hand off to a
# systemd unit instead. Installed by install-hotplug.sh.
# Ref: https://wiki.archlinux.org/title/Udev#Spawning_long-running_processes
ACTION=="change", SUBSYSTEM=="drm", RUN+="/usr/bin/systemctl --no-block start monitor-hotplug.service"
