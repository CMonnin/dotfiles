extract() {
    case "$1" in
        *.tar.gz)  tar xzf "$1" ;;
        *.tar.bz2) tar xjf "$1" ;;
        *.zip)     unzip "$1" ;;
        *.7z)      7z x "$1" ;;
        *.tar.xz)  tar xJf "$1" ;;
        *.tar)     tar xf "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.rar)     unrar x "$1" ;;
        *)         echo "unknown format: $1" ;;
    esac
}

# Git info for prompt
git_info() {
    local branch status indicators ahead behind
    branch=$(git branch --show-current 2>/dev/null) || return
    status=$(git status --porcelain 2>/dev/null)
    [[ "$status" == *"?"*  ]] && indicators+="?"
    [[ "$status" =~ (^|$'\n')[MADRCU] ]] && indicators+="+"
    [[ "$status" =~ (^|$'\n')[\ MADRCU]M ]] && indicators+="!"
    [[ "$status" =~ (^|$'\n')[\ MADRCU]D ]] && indicators+="✘"
    [[ -n $(git stash list 2>/dev/null) ]] && indicators+="\$"
    local ab
    ab=$(git rev-list --left-right --count HEAD...@{u} 2>/dev/null)
    if [[ -n "$ab" ]]; then
        ahead=${ab%%$'\t'*}
        behind=${ab##*$'\t'}
        [[ "$ahead" -gt 0 ]] && indicators+="↑"
        [[ "$behind" -gt 0 ]] && indicators+="↓"
    fi
    [[ -n "$indicators" ]] && indicators=" $indicators"
    echo " (${branch}${indicators})"
}

# Show user@host only over SSH
prompt_user() {
    [[ -n "$SSH_CLIENT" || -n "$SSH_TTY" ]] && \
        if [[ "$LIGHTSCREEN" == "1" ]]; then
            printf '\001\e[38;2;124;111;100m\002%s@%s\001\e[0m\002' "$USER" "$HOSTNAME"
        else
            printf '\001\e[38;2;177;98;134m\002%s@%s\001\e[0m\002' "$USER" "$HOSTNAME"
        fi
}

# Show time only when not in ~
prompt_time() {
    [[ "$PWD" != "$HOME" ]] && \
        if [[ "$LIGHTSCREEN" == "1" ]]; then
            printf '\001\e[38;2;124;111;100m\002%s\001\e[0m\002 ' "$(date +%H:%M)"
        else
            printf '\001\e[38;2;177;98;134m\002%s\001\e[0m\002 ' "$(date +%H:%M)"
        fi
}

# Prompt colors — adapt to lightscreen mode
