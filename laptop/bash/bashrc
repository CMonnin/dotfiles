    # Gruvbox Light: faded yellow path, faded green git
    PS1='$(prompt_time)$(prompt_user)\[\e[38;2;181;87;20m\]\w\[\e[0m\]\[\e[38;2;121;116;14m\]$(git_info)\[\e[0m\]\n\[\e[38;2;181;87;20m\] →\[\e[0m\] '
