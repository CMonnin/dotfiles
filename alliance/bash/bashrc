# Cobralab shared bashrc. Sourced rather than symlinked (the lab's
# `ln -sf ... ~/.bashrc`) so the additions below don't get written into the
# shared file; lab updates are still picked up on every new shell.
COBRALAB_BASHRC=/project/rrg-mchakrav-ab/gdevenyi/quarantine/cobralab-bashrc
if [[ -r "$COBRALAB_BASHRC" ]]; then
    . "$COBRALAB_BASHRC"
elif [[ $- == *i* ]]; then
    echo "bashrc: $COBRALAB_BASHRC not readable, skipping" >&2
fi

# Cian: environment, also needed by non-interactive shells (ssh host cmd, sbatch)
export SLURM_ACCOUNT="rrg-mchakrav-ab"
export PATH="$HOME/.local/bin:$PATH"
export LD_LIBRARY_PATH="$HOME/.local/lib:$LD_LIBRARY_PATH"
export MANPATH="$HOME/.local/share/man:$MANPATH"

# A `return` inside the lab file only leaves that file, so stop here for
# non-interactive shells: printing escape codes would break scp/rsync.
[[ $- != *i* ]] && return

# Cian: interactive
alias ls='ls --color=auto'
alias vim='nvim'
export TERM=xterm-256color
eval "$(~/.local/bin/starship init bash)"

if [[ -n "$SSH_CONNECTION" ]]; then
  echo -ne "\033]11;#200000\007"
fi

extract() {
    case "$1" in
        *.tar.gz)  tar xzf "$1" ;;
        *.tar.bz2) tar xjf "$1" ;;
        *.zip)     unzip "$1" ;;
        *.7z)      7z x "$1" ;;
        *.tar.xz)  tar xJf "$1" ;;
        *.tar)     tar xf "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.rar)     unrar x "$1" ;;
        *)         echo "unknown format: $1" ;;
    esac
}
